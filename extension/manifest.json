{
  "manifest_version": 3,
  "name": "focus guard",
  "version": "1.0.0",
  "description": "Closes the gap when a focus unlock ends: open tabs on a locked site are replaced at once.",
  "incognito": "split",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "storage": { "managed_schema": "schema.json" }
}
